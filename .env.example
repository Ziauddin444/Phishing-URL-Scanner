# Environment Configuration
# Copy this to .env and customize for your environment

# Flask Configuration
FLASK_ENV=development
FLASK_APP=src.app
SECRET_KEY=your-secret-key-change-in-production

# API Configuration
API_PORT=5000
API_HOST=0.0.0.0
DEBUG=True

# Model Configuration
MODEL_DIR=models
DATA_DIR=data

# Feature Analysis Timeout (seconds)
URL_ANALYSIS_TIMEOUT=10

# Logging
LOG_LEVEL=INFO
