# Environment Configuration for Phishing URL Scanner
# Copy this file to .env and update values for your environment
# IMPORTANT: Never commit the actual .env file with real secrets!

# Flask Configuration
FLASK_ENV=development
FLASK_APP=src.app
SECRET_KEY=your-secret-key-here-change-in-production

# Server Configuration
API_PORT=3000
API_HOST=0.0.0.0

# Model Configuration
MODEL_DIR=models
DATA_DIR=data

# Feature Analysis
URL_ANALYSIS_TIMEOUT=10

# Debug Mode (set to False in production)
DEBUG=False

# Additional Optional Configurations
# LOG_LEVEL=INFO
# DATABASE_URL=sqlite:///phishing_scanner.db


# Logging
LOG_LEVEL=INFO
