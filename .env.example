# Environment Configuration for Phishing URL Scanner
# Copy this file to .env and update values for your environment
# IMPORTANT: Never commit the actual .env file with real secrets!
# Run `pip-audit -r requirements.txt` periodically to detect new CVEs.

# Flask Configuration
# SECURITY: Set to 'production' for production deployments
FLASK_ENV=production
FLASK_APP=src.app

# SECURITY: Generate SECRET_KEY for production with:
# python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production (min 32 chars). Auto-generated in development.
SECRET_KEY=your-64-character-secret-key-here-required-for-production

# Server Configuration
API_PORT=3000
API_HOST=0.0.0.0

# Model Configuration
MODEL_DIR=models
DATA_DIR=data

# Feature Analysis
URL_ANALYSIS_TIMEOUT=10

# Debug Mode (set to False in production)
DEBUG=False

# Logging
LOG_LEVEL=INFO

# CORS: Comma-separated list of allowed origins.
# Use '*' for a fully open public API (e.g. demo / local dev).
# For production, restrict to your own domains:
#   CORS_ALLOWED_ORIGINS=https://myapp.com,https://staging.myapp.com
CORS_ALLOWED_ORIGINS=*
